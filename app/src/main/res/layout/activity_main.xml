<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 上层实际业务布局 -->
    <LinearLayout
        android:id="@+id/contentRow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- 左侧主视频：主页为小封面，播放时铺满；边看边练时自然占60%。 -->
        <FrameLayout
            android:id="@+id/leftContentContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="#FFFFFF">

            <androidx.media3.ui.PlayerView
                android:id="@+id/mainVideoPlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="#FFFFFF"
                app:resize_mode="fit"
                app:shutter_background_color="#FFFFFF"
                app:use_controller="false"
                android:visibility="gone" />

            <!-- 主视频静态小封面，点击后进入主视频播放页。 -->
            <ImageView
                android:id="@+id/mainVideoCoverView"
                android:layout_width="420dp"
                android:layout_height="236dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="72dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:contentDescription="播放主视频"
                android:focusable="true"
                android:nextFocusUp="@id/mainVideoCoverView"
                android:nextFocusDown="@id/mainVideoCoverView"
                android:nextFocusLeft="@id/mainVideoCoverView"
                android:nextFocusRight="@id/mainVideoCoverView"
                android:scaleType="fitCenter"
                android:src="@raw/mian" />

        </FrameLayout>

        <!-- 进入边看边练 -->
        <FrameLayout
            android:id="@+id/practicePanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#FFFFFF"
            android:visibility="gone">

            <!-- 页面1：边看边练主界面：视频选择 -->
            <LinearLayout
                android:id="@+id/videoSelectionPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— 课程选择 —"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textColor="#3D2C78"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <!-- 中间课程预览区域 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="470dp"
                    android:layout_marginTop="16dp">

                    <!-- 左箭头 -->
                    <TextView
                        android:id="@+id/tvPreviousWorkout"
                        android:layout_width="45dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#7555D9"
                        android:textSize="46sp"
                        android:textStyle="bold" />

                    <!-- 当前课程卡片 -->
                    <FrameLayout
                        android:id="@+id/workoutPreviewCard"
                        android:layout_width="280dp"
                        android:layout_height="450dp"
                        android:layout_gravity="center"
                        android:background="@drawable/workout_preview_background"
                        android:clipToOutline="true"
                        android:foreground="@drawable/workout_preview_border"
                        android:foregroundGravity="fill"
                        android:padding="3dp">

                        <!-- 内层负责裁剪视频和信息区域的圆角。 -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/workout_preview_content_background"
                            android:clipToOutline="true">

                            <androidx.media3.ui.PlayerView
                                android:id="@+id/workoutPreviewPlayerView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:resize_mode="zoom"
                                app:use_controller="false" />

                            <!-- 底部课程信息 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="78dp"
                                android:layout_gravity="bottom"
                                android:layout_margin="10dp"
                                android:background="@drawable/workout_preview_info_background"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp">

                                <TextView
                                    android:id="@+id/workoutPreviewTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="健身视频 1"
                                    android:textColor="#FFFFFF"
                                    android:textSize="21sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/workoutPreviewIndex"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="1 / 2"
                                    android:textColor="#DDDDDD"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </FrameLayout>

                    <!-- 右箭头 -->
                    <TextView
                        android:id="@+id/tvNextWorkout"
                        android:layout_width="45dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#7555D9"
                        android:textSize="46sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- 提示 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="按左右键切换课程"
                    android:fontFamily="sans-serif"
                    android:textColor="#746C88"
                    android:textSize="15sp" />

                <!-- 唯一保留的操作按钮 -->
                <Button
                    android:id="@+id/btnStartWorkout"
                    android:layout_width="250dp"
                    android:layout_height="65dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/tv_secondary_button_tint"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="立即开始"
                    android:textColor="@color/tv_button_text_tint"
                    android:textSize="19sp" />
            </LinearLayout>

            <!-- 页面2：视频播放页面 -->
            <FrameLayout
                android:id="@+id/playingPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <!-- 健身视频 -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/practicePlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"
                    app:resize_mode="fit"
                    app:shutter_background_color="#FFFFFF" />

                <!-- 火柴人 -->
                <FrameLayout
                    android:id="@+id/skeletonContainer"
                    android:layout_width="124dp"
                    android:layout_height="200dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="88dp"
                    android:background="@drawable/skeleton_panel_background"
                    android:clipToOutline="true"
                    android:elevation="8dp"
                    android:visibility="gone">

                    <com.example.poseottdemo.renderer.SkeletonView
                        android:id="@+id/skeletonView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- 评分节点出现的关节纠错提示，不改变火柴人面板尺寸。 -->
                    <TextView
                        android:id="@+id/tvJointCorrection"
                        android:layout_width="112dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/joint_correction_badge_background"
                        android:elevation="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="#554F61"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- 自定义课程进度 -->
                <LinearLayout
                    android:id="@+id/playbackProgressPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/playback_progress_panel_background"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="11dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPlaybackTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="5dp"
                        android:text="00:00 / 00:00"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#4B4263"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/playbackProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="1000"
                        android:progress="0"
                        android:progressDrawable="@drawable/playback_progress_drawable" />

                </LinearLayout>

                <!-- 单次评分浮字 -->
                <LinearLayout
                    android:id="@+id/scorePanel"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="40dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCurrentScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#00D9FF"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScoreFeedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:shadowColor="#CC8F00FF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="35sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 正式训练前倒计时 -->
                <FrameLayout
                    android:id="@+id/preparationOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/countdown_page_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="360dp"
                        android:layout_height="520dp"
                        android:layout_gravity="center"
                        android:background="@drawable/countdown_card_background"
                        android:elevation="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="36dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="— 动作准备 —"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#6E43D8"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="190dp"
                            android:layout_height="190dp"
                            android:layout_marginTop="28dp">

                            <ProgressBar
                                android:id="@+id/preparationCountdownProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="5000"
                                android:progress="5000"
                                android:progressDrawable="@drawable/countdown_ring_progress" />

                            <TextView
                                android:id="@+id/tvPreparationCountdown"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="5"
                                android:fontFamily="sans-serif-light"
                                android:textColor="#5425C9"
                                android:textSize="80sp"
                                android:textStyle="bold" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp"
                            android:text="准备开始运动"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#161424"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="调整站位，保持全身进入手机画面"
                            android:textColor="#746F84"
                            android:textSize="16sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 纯视频模式右上角扫码按钮 -->
                <Button
                    android:id="@+id/btnScanPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="20dp"
                    android:elevation="12dp"
                    android:focusable="true"
                    android:text="扫码连接"
                    android:visibility="gone"
                    android:backgroundTint="@color/tv_secondary_button_tint"
                    android:textColor="@color/tv_button_text_tint"/>

                <!-- 二维码浮层 -->
                <FrameLayout
                    android:id="@+id/pairingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/countdown_page_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="360dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/countdown_card_background"
                        android:elevation="20dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="扫码连接"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#2D2640"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="扫码后可显示实时动作"
                            android:fontFamily="sans-serif"
                            android:textColor="#746F84"
                            android:textSize="17sp" />

                        <ImageView
                            android:id="@+id/qrImageView"
                            android:layout_width="230dp"
                            android:layout_height="230dp"
                            android:layout_marginTop="20dp"
                            android:background="#FFFFFF" />

                        <TextView
                            android:id="@+id/pairingStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="等待手机连接..."
                            android:fontFamily="sans-serif"
                            android:textColor="#746F84"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/btnQrBack"
                            android:layout_width="220dp"
                            android:layout_height="60dp"
                            android:layout_marginTop="35dp"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="返回"
                            android:backgroundTint="@color/tv_secondary_button_tint"
                            android:textColor="@color/tv_button_text_tint"
                            android:textSize="19sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 手机连接成功后的准备动作检测页面 -->
                <FrameLayout
                    android:id="@+id/readyCheckOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/countdown_page_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="380dp"
                        android:layout_height="520dp"
                        android:layout_gravity="center"
                        android:background="@drawable/countdown_card_background"
                        android:elevation="24dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="36dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.06"
                            android:text="— 动作检测 —"
                            android:textColor="#6E43D8"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="连接成功"
                            android:textColor="#2D2640"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="175dp"
                            android:layout_height="270dp"
                            android:layout_marginTop="15dp"
                            android:contentDescription="举起右手动作示意"
                            android:src="@drawable/ic_raise_right_hand" />

                        <TextView
                            android:id="@+id/tvReadyCheckStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="请面对手机，举起右手"
                            android:textColor="#3D2C78"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:text="请保持动作，检测完成后将自动开始"
                            android:textColor="#746F84"
                            android:textSize="16sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 手机断开连接浮层 -->
                <FrameLayout
                    android:id="@+id/disconnectedOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#800F0A20"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="360dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/countdown_card_background"
                        android:elevation="20dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="30dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="手机已断开连接"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#2D2640"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="可继续观看视频，或重新扫码连接手机"
                            android:fontFamily="sans-serif"
                            android:textColor="#746F84"
                            android:textSize="17sp" />

                        <Button
                            android:id="@+id/btnDisconnectKnown"
                            android:layout_width="240dp"
                            android:layout_height="62dp"
                            android:layout_marginTop="28dp"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="知道了"
                            android:backgroundTint="@color/tv_secondary_button_tint"
                            android:textColor="@color/tv_button_text_tint"
                            android:textSize="19sp"/>

                        <Button
                            android:id="@+id/btnReconnect"
                            android:layout_width="240dp"
                            android:layout_height="62dp"
                            android:layout_marginTop="14dp"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="重新连接"
                            android:backgroundTint="@color/tv_secondary_button_tint"
                            android:textColor="@color/tv_button_text_tint"
                            android:textSize="19sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 播放过程中退出训练确认 -->
                <FrameLayout
                    android:id="@+id/exitConfirmationOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#800F0A20"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="360dp"
                        android:layout_height="260dp"
                        android:layout_gravity="center"
                        android:background="@drawable/countdown_card_background"
                        android:elevation="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="30dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="是否退出运动？"
                            android:textColor="#2D2640"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif"
                            android:text="退出后，本次训练进度将不会保留"
                            android:textColor="#746F84"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="30dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnCancelExitWorkout"
                                android:layout_width="130dp"
                                android:layout_height="60dp"
                                android:backgroundTint="@color/tv_secondary_button_tint"
                                android:focusable="true"
                                android:fontFamily="sans-serif-medium"
                                android:text="取消"
                                android:textColor="@color/tv_button_text_tint"
                                android:textSize="19sp" />

                            <Button
                                android:id="@+id/btnConfirmExitWorkout"
                                android:layout_width="130dp"
                                android:layout_height="60dp"
                                android:layout_marginStart="16dp"
                                android:backgroundTint="@color/tv_secondary_button_tint"
                                android:focusable="true"
                                android:fontFamily="sans-serif-medium"
                                android:text="确认"
                                android:textColor="@color/tv_button_text_tint"
                                android:textSize="19sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- 训练结束总分 -->
                <FrameLayout
                    android:id="@+id/finalScoreOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/countdown_page_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="360dp"
                        android:layout_height="530dp"
                        android:layout_gravity="center"
                        android:background="@drawable/countdown_card_background"
                        android:elevation="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="36dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="— 本次训练 —"
                            android:textColor="#6E43D8"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/tvFinalScoreTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="训练完成"
                            android:layout_marginTop="42dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#2D2640"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFinalScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:fontFamily="sans-serif-medium"
                            android:shadowColor="#CC8F00FF"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="16"
                            android:textColor="#00D9FF"
                            android:textSize="76sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="最终得分"
                            android:textColor="#746F84"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvFinalAverageScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="0"
                                    android:textColor="#6E43D8"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="动作平均分"
                                    android:textColor="#746F84"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="48dp"
                                android:background="#DDD4F4" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvFinalCompletionRate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="0%"
                                    android:textColor="#6E43D8"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="有效完成率"
                                    android:textColor="#746F84"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="30dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnFinalBack"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/tv_secondary_button_tint"
                                android:focusable="true"
                                android:fontFamily="sans-serif-medium"
                                android:text="返回"
                                android:textColor="@color/tv_button_text_tint"
                                android:textSize="18sp" />

                            <Button
                                android:id="@+id/btnFinalAdjacent"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/tv_secondary_button_tint"
                                android:focusable="true"
                                android:fontFamily="sans-serif-medium"
                                android:text="下一个"
                                android:textColor="@color/tv_button_text_tint"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                </FrameLayout>

            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
